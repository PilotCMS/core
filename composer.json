{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "pilotcms/core",
    "description": "The complete versioned CMS application for Pilot.",
    "type": "library",
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/PilotCMS/pilot-laravel.git"
        }
    ],
    "require": {
        "php": "^8.4.1",
        "illuminate/console": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/support": "^12.0",
        "illuminate/view": "^12.0",
        "laravel/fortify": "^1.30",
        "livewire/flux": "^2.9.0",
        "livewire/livewire": "^4.0",
        "nuwave/lighthouse": "^6.64",
        "pilot/laravel": "^0.1",
        "spatie/laravel-permission": "^6.24",
        "symfony/process": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "Pilot\\Core\\": "src/",
            "Pilot\\Core\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pilot\\Core\\PilotCoreServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
